{
  "name": "idempotent-ledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --parallel run dev:api dev:web",
    "dev:api": "bun --hot --env-file=.env apps/api/src/server.ts",
    "dev:web": "bun --env-file=.env run --filter '@banking-ledger/web' dev",
    "start": "bun --env-file=.env apps/api/src/server.ts",
    "projections": "bun --env-file=.env apps/api/src/features/projection/projections.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "latest",
    "drizzle-kit": "0.31.4",
    "postgres": "3.4.5",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
