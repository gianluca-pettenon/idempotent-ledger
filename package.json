{
  "name": "banking-ledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --parallel run dev:api dev:web",
    "dev:api": "bun --hot --env-file=.env apps/api/src/server.ts",
    "dev:web": "bun --env-file=.env run --filter '@banking-ledger/web' dev",
    "start": "bun --env-file=.env apps/api/src/server.ts",
    "projector:balances": "bun --env-file=.env apps/api/src/features/projection/services/balances.projector.ts",
    "projector:statements": "bun --env-file=.env apps/api/src/features/projection/services/statements.projector.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
