{
  "name": "idempotent-ledger",
  "version": "1.0.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --parallel run dev:api dev:web",
    "dev:api": "bun --hot --env-file=.env apps/api/src/server.ts",
    "dev:web": "bun --env-file=.env run --filter '@idempotent-ledger/web' dev",
    "start": "bun --env-file=.env apps/api/src/server.ts",
    "projections": "bun --env-file=.env apps/api/src/features/projection/projections.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "latest",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.5",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ]
        }
      ]
    ]
  }
}
